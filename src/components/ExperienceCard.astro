---
import RichText from "./RichText.astro";

const { experience } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const thumb = experience.thumbnail ? base + experience.thumbnail : null;
---

<a class="card" href={`${base}/experience/${experience.slug}/`}>
  <div class="thumb">
    {
      thumb ? (
        <img src={thumb} alt={experience.title} loading="lazy" />
      ) : (
        <div class="thumb-placeholder"><RichText text={experience.title} /></div>
      )
    }
    <span class="period"><RichText text={experience.period} /></span>
  </div>
  <div class="body">
    <p class="org"><RichText text={experience.org} /></p>
    <h3><RichText text={experience.title} /></h3>
    <div class="tags">
      {experience.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
  <span class="arrow">→</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: var(--shadow-hover);
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .card:hover .thumb img {
    transform: scale(1.04);
  }
  .thumb-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 0 24px;
    text-align: center;
    line-height: 1.4;
    color: var(--text-dim);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    background: var(--placeholder);
  }
  .period {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--text-dim);
    background: var(--overlay);
    padding: 2px 8px;
    border-radius: 6px;
    backdrop-filter: blur(4px);
  }
  .body {
    padding: 18px 20px 22px;
  }
  .org {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-2);
    margin-bottom: 2px;
  }
  h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 14px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .arrow {
    position: absolute;
    bottom: 20px;
    right: 20px;
    color: var(--accent);
    font-size: 18px;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }
  .card:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
