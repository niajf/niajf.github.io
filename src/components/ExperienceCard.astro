---
const { experience } = Astro.props;
const meta = [experience.period, experience.duration, experience.role].filter(Boolean);

const blocks = [
  { label: "概要", data: experience.overview },
  { label: "参加理由", data: experience.motivation },
  { label: "学び", data: experience.learnings },
  { label: "成長", data: experience.growth },
].filter((b) => b.data && (b.data.summary || b.data.points?.length));
---

<article class="exp">
  <div class="head">
    <p class="org">{experience.org}</p>
    <h3>{experience.title}</h3>
    {
      meta.length > 0 && (
        <p class="meta">
          {meta.map((m, i) => (
            <>
              {i > 0 && <span class="sep">/</span>}
              <span>{m}</span>
            </>
          ))}
        </p>
      )
    }
  </div>

  {
    blocks.map((b) => (
      <section class="block">
        <h4>{b.label}</h4>
        {b.data.summary && <p class="summary">{b.data.summary}</p>}
        {b.data.points?.length > 0 && (
          <ul class="points">
            {b.data.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <div class="tags">
    {experience.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
</article>

<style>
  .exp {
    position: relative;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px 28px 28px;
    padding-left: 32px;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .exp::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
  }
  .exp:hover {
    border-color: var(--accent);
  }
  .head {
    margin-bottom: 24px;
  }
  .org {
    font-size: 13px;
    color: var(--accent-2);
    margin-bottom: 2px;
  }
  h3 {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.3;
  }
  .meta {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-dim);
    margin-top: 6px;
  }
  .sep {
    margin: 0 8px;
    opacity: 0.5;
  }
  .block + .block {
    margin-top: 24px;
  }
  h4 {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .summary {
    font-size: 15px;
    color: var(--text);
  }
  .summary + .points {
    margin-top: 12px;
  }
  .points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .points li {
    position: relative;
    padding-left: 24px;
    font-size: 15px;
  }
  .points li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 26px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 520px) {
    .exp {
      padding: 22px 20px 24px;
      padding-left: 24px;
    }
  }
</style>
