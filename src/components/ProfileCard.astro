---
import RichText from "./RichText.astro";

const { profile } = Astro.props;
// intro は文字列でも、段落ごとの配列でもよい
const paragraphs = [].concat(profile.intro ?? []).filter(Boolean);
// value が空の項目は表示しない（あとから埋められるように JSON には残しておける）
const items = (profile.items ?? []).filter((i) => i.value);
---

<div class="profile">
  <div class="about">
    {profile.nameEn && <p class="name-en">{profile.nameEn}</p>}
    <h3 class="name">{profile.name}</h3>
    {
      paragraphs.length > 0 && (
        <div class="text">
          {paragraphs.map((p) => (
            <p>
              <RichText text={p} />
            </p>
          ))}
        </div>
      )
    }
  </div>
  {
    items.length > 0 && (
      <dl class="kv">
        {items.map((i) => (
          <>
            <dt>
              <RichText text={i.label} />
            </dt>
            <dd>
              {i.url ? (
                <a href={i.url} target="_blank" rel="noopener">
                  <RichText text={i.value} />
                </a>
              ) : (
                <RichText text={i.value} />
              )}
            </dd>
          </>
        ))}
      </dl>
    )
  }
</div>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 32px;
    align-items: start;
  }
  .name-en {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .name {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 16px;
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 15px;
    line-height: 1.85;
  }

  /* ラベルと値の一覧 */
  .kv {
    display: grid;
    grid-template-columns: max-content 1fr;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .kv dt,
  .kv dd {
    padding: 11px 18px;
    border-top: 1px solid var(--border);
  }
  .kv dt:first-of-type,
  .kv dd:first-of-type {
    border-top: none;
  }
  .kv dt {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dim);
    white-space: nowrap;
    padding-top: 12px;
  }
  .kv dd {
    font-size: 15px;
    padding-left: 0;
  }
  .kv a {
    color: var(--accent);
  }
  .kv a:hover {
    text-decoration: underline;
  }

  @media (max-width: 760px) {
    .profile {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
  @media (max-width: 560px) {
    .kv {
      grid-template-columns: 1fr;
    }
    .kv dt {
      padding-bottom: 0;
    }
    .kv dd {
      border-top: none;
      padding: 2px 18px 11px;
    }
  }
</style>
