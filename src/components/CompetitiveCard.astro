---
import { summarize } from "../utils/atcoder.js";

const { item } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const s = summarize(item);
// サムネイルの代わりに、レーティング推移の小さな折れ線を描く
const rated = item.history.filter((h) => h.rated);
const t = rated.map((h) => Date.parse(h.date));
const top = Math.max(...rated.map((h) => h.rating), 1);
const pts = rated.map((h, i) => [((t[i] - t[0]) / (t.at(-1) - t[0] || 1)) * 100, 40 - (h.rating / top) * 34]);
const line = "M" + pts.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join("L");
---

<a class:list={["card", { featured: item.featured }]} href={`${base}/competitive/${item.slug}/`}>
  <div class="thumb">
    <div class="rating">
      <p class="rating-label">AtCoder Rating</p>
      <p class="rating-value">{s.rating}</p>
      <p class="rating-rank"><i style={`background:${s.color.hex}`}></i>{s.color.name}色</p>
    </div>
    <svg class="spark" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
      <path class="spark-area" d={`${line}L100,40L0,40Z`} />
      <path class="spark-line" d={line} />
    </svg>
    {item.featured && <span class="pick">PICK UP</span>}
    <span class="year">{item.period}</span>
  </div>
  <div class="body">
    <p class="platform">{item.platform}</p>
    <h3>{item.title}</h3>
    <div class="tags">
      {item.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
  <span class="arrow">→</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  /* 一押し：行の横幅いっぱいに広げ、枠線とバッジで目立たせる */
  .card.featured {
    grid-column: 1 / -1;
    border: 2px solid var(--accent);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: var(--shadow-hover);
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--placeholder);
    overflow: hidden;
  }
  .rating {
    position: absolute;
    top: 18px;
    left: 20px;
  }
  /* PICK UP バッジと重ならないように下げる */
  .card.featured .rating {
    top: 44px;
  }
  .rating-label {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-dim);
  }
  .rating-value {
    font-size: 44px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0;
  }
  .rating-rank {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dim);
  }
  .rating-rank i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .spark {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 50%;
  }
  .spark-area {
    fill: var(--accent);
    opacity: 0.12;
  }
  .spark-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .year {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--text-dim);
    background: var(--overlay);
    padding: 2px 8px;
    border-radius: 6px;
    backdrop-filter: blur(4px);
  }
  .body {
    padding: 18px 20px 22px;
  }
  .platform {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent-2);
    margin-bottom: 2px;
  }
  h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 4px;
  }
  .stats {
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 14px;
    word-break: auto-phrase;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .arrow {
    position: absolute;
    bottom: 20px;
    right: 20px;
    color: var(--accent);
    font-size: 18px;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }
  .card:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .pick {
    position: absolute;
    top: 12px;
    left: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 600;
    color: var(--on-accent);
    background: var(--accent);
    padding: 2px 10px;
    border-radius: 6px;
  }
  /* PC では画像を左、説明を右に並べる */
  @media (min-width: 760px) {
    .card.featured {
      flex-direction: row;
    }
    .card.featured .thumb {
      flex: 0 0 58%;
    }
    .card.featured .body {
      align-self: center;
      padding: 28px 32px;
    }
  }
</style>
