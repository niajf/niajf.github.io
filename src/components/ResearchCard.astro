---
import { youtubeId } from "../utils/youtube.js";

const { research } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const videoId = youtubeId(research.video);
const thumb = research.thumbnail
  ? base + research.thumbnail
  : videoId
    ? `https://img.youtube.com/vi/${videoId}/hqdefault.jpg`
    : null;
---

<a class="card" href={`${base}/research/${research.slug}/`}>
  <div class="thumb">
    {
      thumb ? (
        <img src={thumb} alt={research.title} loading="lazy" />
      ) : (
        <div class="thumb-placeholder">{research.title}</div>
      )
    }
    <span class="year">{research.year}</span>
  </div>
  <div class="body">
    <p class="conference">{research.conference}</p>
    <h3>{research.title}</h3>
    {
      research.awards?.length > 0 && (
        <ul class="awards">
          {research.awards.map((a) => <li>{a}</li>)}
        </ul>
      )
    }
    <div class="tags">
      {videoId && <span class="tag">発表動画</span>}
      {research.slides && <span class="tag">発表スライド</span>}
    </div>
  </div>
  <span class="arrow">→</span>
</a>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 16px 40px -16px rgba(124, 140, 255, 0.45);
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    overflow: hidden;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .card:hover .thumb img {
    transform: scale(1.04);
  }
  .thumb-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 0 24px;
    text-align: center;
    line-height: 1.4;
    color: var(--text-dim);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.04em;
    background: linear-gradient(135deg, #1a2030, #131826);
  }
  .year {
    position: absolute;
    top: 12px;
    right: 12px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    color: var(--text-dim);
    background: rgba(11, 14, 20, 0.7);
    padding: 2px 8px;
    border-radius: 6px;
    backdrop-filter: blur(4px);
  }
  .body {
    padding: 18px 20px 22px;
  }
  .conference {
    font-size: 13px;
    color: var(--accent-2);
    margin-bottom: 2px;
  }
  h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 14px;
  }
  .awards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: -6px 0 14px;
  }
  .awards li {
    position: relative;
    padding-left: 20px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--award);
  }
  .awards li::before {
    content: "★";
    position: absolute;
    left: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .arrow {
    position: absolute;
    bottom: 20px;
    right: 20px;
    color: var(--accent);
    font-size: 18px;
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.2s ease;
  }
  .card:hover .arrow {
    opacity: 1;
    transform: translateX(0);
  }
</style>
