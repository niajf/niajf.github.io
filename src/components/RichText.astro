---
// `バッククォート` で囲んだ部分をインラインコードとして、\n を改行として表示する
const { text } = Astro.props;
const parts = String(text ?? "").split("`");
---

{
  parts.map((part, i) =>
    i % 2 === 1 ? <code>{part}</code> : part.split("\n").map((line, j) => (j > 0 ? [<br />, line] : line)),
  )
}

<style>
  code {
    font-family: "JetBrains Mono", "Noto Sans JP", monospace;
    font-size: 0.88em;
    color: var(--text);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    padding: 1px 6px;
    border-radius: 5px;
    overflow-wrap: anywhere;
  }
</style>
