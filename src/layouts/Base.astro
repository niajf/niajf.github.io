---
const { title, description } = Astro.props;
const SITE = "Taiga — Game Engineer Portfolio";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description ?? "ゲームエンジニアを志望する学生のポートフォリオ"} />
    <title>{title ? `${title} | ${SITE}` : SITE}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f4f5f8;
    --bg-soft: #eceef3;
    --card: #ffffff;
    --card-hover: #ffffff;
    --border: #d9dde6;
    --text: #1c2230;
    --text-dim: #566074;
    /* 色の役割: accent = リンク・操作 / accent-2 = 所属 / award = 受賞 */
    --accent: #4251cc;
    --accent-2: #0b7a71;
    --award: #9a5b00;
    --accent-soft: rgba(66, 81, 204, 0.08);
    --accent-line: rgba(66, 81, 204, 0.25);
    --on-accent: #ffffff;
    --tag-text: #3b4354;
    --tag-bg: #eef0f5;
    --tag-border: #dfe3ea;
    --placeholder: linear-gradient(135deg, #e7eaf2, #dde1eb);
    --overlay: rgba(255, 255, 255, 0.88);
    --shadow: 0 1px 2px rgba(22, 30, 60, 0.06), 0 6px 20px -8px rgba(22, 30, 60, 0.12);
    --shadow-hover: 0 16px 40px -16px rgba(66, 81, 204, 0.35);
    /* コードブロックはライトテーマでも暗いまま */
    --code-bg: #161b26;
    --radius: 16px;
    --maxw: 1080px;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", "Noto Sans JP", system-ui, sans-serif;
    line-height: 1.7;
    letter-spacing: 0.03em;
    -webkit-font-smoothing: antialiased;
    position: relative;
    min-height: 100vh;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }

  .tag {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    color: var(--tag-text);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid var(--border);
    transition: all 0.18s ease;
  }
  .btn-primary {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
  .btn-primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }
  .btn-ghost:hover {
    background: var(--card-hover);
    border-color: var(--accent);
  }
</style>
