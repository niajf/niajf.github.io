---
import Base from "../layouts/Base.astro";
import WorkCard from "../components/WorkCard.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import ResearchCard from "../components/ResearchCard.astro";
import CircleCard from "../components/CircleCard.astro";
import works from "../data/works.json";
import experiences from "../data/experiences.json";
import researchList from "../data/research.json";
import circleList from "../data/circle.json";

const sorted = [...works].sort(
  (a, b) => Number(b.featured) - Number(a.featured) || b.year - a.year,
);
const sortedResearch = [...researchList].sort((a, b) => b.year - a.year);
const sortedCircle = [...circleList].sort((a, b) => b.year - a.year);
const allTags = [
  ...new Set([
    ...works.flatMap((w) => w.tags),
    ...experiences.flatMap((e) => e.tags),
    ...circleList.flatMap((c) => c.tags),
  ]),
];
---

<Base title={null} description="ゲームエンジニアを志望する学生の作品ポートフォリオ">
  <main>
    <header class="hero container">
      <p class="eyebrow">近藤　大河　</br> 
        信州大学 大学院 総合理工学研究科
      </p>
      <h1>PORTFOLIO</h1>
      <p class="intro">
        ゲームエンジニアを目指して制作した作品と、開発を通して得た経験をまとめています
      </p>
      <div class="hero-links">
        <a class="btn btn-primary" href="https://github.com/niajf" target="_blank" rel="noopener">
          GitHub
        </a>
        <a class="btn btn-ghost" href="#works">作品を見る ↓</a>
        <a class="btn btn-ghost" href="#research">研究を見る ↓</a>
        <a class="btn btn-ghost" href="#circle">サークル活動を見る ↓</a>
        <a class="btn btn-ghost" href="#experience">経験を見る ↓</a>
      </div>
      <div class="skill-strip">
        {allTags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    <section id="works" class="container">
      <div class="section-head">
        <h2>Works</h2>
        <span class="count">{works.length} projects</span>
      </div>
      <div class="grid">
        {sorted.map((w) => <WorkCard work={w} />)}
      </div>
    </section>

    <section id="research" class="container">
      <div class="section-head">
        <h2>Research</h2>
        <span class="count">{researchList.length} presentations</span>
      </div>
      <div class="grid">
        {sortedResearch.map((r) => <ResearchCard research={r} />)}
      </div>
    </section>
    
    <section id="circle" class="container">
      <div class="section-head">
        <h2>Club Activities</h2>
        <span class="count">{circleList.length} activities</span>
      </div>
      <div class="grid">
        {sortedCircle.map((c) => <CircleCard circle={c} />)}
      </div>
    </section>

    <section id="experience" class="container">
      <div class="section-head">
        <h2>Experience</h2>
        <span class="count">{experiences.length} experience</span>
      </div>
      <div class="grid">
        {experiences.map((e) => <ExperienceCard experience={e} />)}
      </div>
    </section>

    <footer class="container">
      <p>© {new Date().getFullYear()} Taiga · Built with Astro & GitHub Pages</p>
    </footer>
  </main>
</Base>

<style>
  main {
    padding-bottom: 80px;
  }
  .hero {
    padding: 96px 24px 64px;
  }
  .eyebrow {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-bottom: 14px;
  }
  h1 {
    font-size: clamp(48px, 9vw, 84px);
    font-weight: 700;
    line-height: 1;
    /* グラデーションを見出しの横幅ではなく文字の幅に合わせる */
    width: fit-content;
    background: linear-gradient(120deg, var(--text) 15%, var(--accent) 55%, var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 12px;
  }
  .role {
    font-size: 17px;
    color: var(--text-dim);
    margin-bottom: 24px;
  }
  .intro {
    font-size: 16px;
    max-width: 560px;
    margin-bottom: 32px;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 40px;
  }
  .skill-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  h2 {
    font-size: 28px;
    font-weight: 700;
  }
  .count {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--text-dim);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
  }
  #research,
  #experience,
  #circle {
    margin-top: 88px;
  }
  footer {
    margin-top: 80px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 14px;
    text-align: center;
  }
</style>
