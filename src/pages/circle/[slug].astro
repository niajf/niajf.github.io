---
import Base from "../../layouts/Base.astro";
import RichText from "../../components/RichText.astro";
import circleList from "../../data/circle.json";
import { youtubeId } from "../../utils/youtube.js";

export function getStaticPaths() {
  return circleList.map((circle) => ({
    params: { slug: circle.slug },
    props: { circle },
  }));
}

const { circle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// description は文字列でも、段落ごとの配列でもよい
const paragraphs = [].concat(circle.description ?? []).filter(Boolean);
const videos = (circle.videos ?? [])
  .filter((v) => v.url)
  .map((v) => ({ ...v, id: youtubeId(v.url) }));
const sections = circle.sections ?? [];
const pad = (n) => String(n).padStart(2, "0");
---

<Base title={circle.title} description={`${circle.circle} での活動`}>
  <main class="container">
    <a class="back" href={`${base}/#circle`}>← Club Activities に戻る</a>

    <header class="head">
      <p class="meta">
        <span class="yr">{circle.year}</span>
        <span class="circle"><RichText text={circle.circle} /></span>
      </p>
      <h1><RichText text={circle.title} /></h1>
      <div class="tags">
        {circle.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      {
        videos.length > 0 && (
          <div class="actions">
            <a class="btn btn-primary" href="#video">
              演舞動画を見る
            </a>
          </div>
        )
      }
    </header>

    {
      circle.awards?.length > 0 && (
        <section class="block">
          <h2>受賞歴</h2>
          <ul class="awards">
            {circle.awards.map((a) => <li><RichText text={a} /></li>)}
          </ul>
        </section>
      )
    }

    {
      (paragraphs.length > 0 || circle.spec) && (
        <section class="block">
          <h2>作品について</h2>
          {paragraphs.length > 0 && (
            <div class="text">
              {paragraphs.map((p) => (
                <p><RichText text={p} /></p>
              ))}
            </div>
          )}
          {circle.spec && (
            <dl class="kv">
              {circle.spec.map((s) => (
                <>
                  <dt><RichText text={s.label} /></dt>
                  <dd><RichText text={s.value} /></dd>
                </>
              ))}
            </dl>
          )}
        </section>
      )
    }

    {
      sections.map((s) => (
        <section class="block">
          <h2><RichText text={s.title} /></h2>
          {s.summary && (
            <p class="lead">
              <RichText text={s.summary} />
            </p>
          )}
          {s.points && (
            <ul class="points">
              {s.points.map((p) => (
                <li>
                  <RichText text={p} />
                </li>
              ))}
            </ul>
          )}
          {s.cards && (
            <div class="cards">
              {s.cards.map((c) => (
                <div class="info-card">
                  <h3><RichText text={c.title} /></h3>
                  <p>
                    <RichText text={c.text} />
                  </p>
                </div>
              ))}
            </div>
          )}
          {s.steps && (
            <ol class="steps">
              {s.steps.map((st, i) => (
                <li class="step">
                  <div class="step-head">
                    <span class="step-num">{pad(i + 1)}</span>
                    <h3><RichText text={st.title} /></h3>
                    {st.date && <span class="badge">{st.date}</span>}
                  </div>
                  <p>
                    <RichText text={st.text} />
                  </p>
                </li>
              ))}
            </ol>
          )}
          {s.tables?.map((t) => (
            <div class="table-block">
              {t.caption && <p class="table-caption"><RichText text={t.caption} /></p>}
              <div class="table-wrap">
                <table>
                  <thead>
                    <tr>
                      {t.head.map((h) => (
                        <th>
                          <RichText text={h} />
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {t.rows.map((r) => (
                      <tr>
                        {r.map((cell) => (
                          <td>
                            <RichText text={cell} />
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          ))}
        </section>
      ))
    }

    {
      videos.length > 0 && (
        <section class="block" id="video">
          <h2>動画</h2>
          <div class="videos">
            {videos.map((v) => (
              <div class="video">
                {v.title && <h3><RichText text={v.title} /></h3>}
                {v.id ? (
                  <div class="frame">
                    <iframe
                      src={`https://www.youtube.com/embed/${v.id}`}
                      title={`${circle.title} ${v.title ?? "動画"}`}
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                ) : (
                  <a class="btn btn-ghost" href={v.url} target="_blank" rel="noopener">
                    動画を開く
                  </a>
                )}
                {v.description && <p class="video-desc"><RichText text={v.description} /></p>}
              </div>
            ))}
          </div>
        </section>
      )
    }

    <a class="back back-bottom" href={`${base}/#circle`}>← Club Activities に戻る</a>
  </main>
</Base>

<style>
  main {
    padding: 48px 24px 100px;
    max-width: 820px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 40px;
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--accent);
  }
  .back-bottom {
    margin: 8px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    width: 100%;
  }
  .head {
    margin-bottom: 40px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 14px;
  }
  .yr {
    font-family: "JetBrains Mono", monospace;
    color: var(--accent);
  }
  .circle {
    color: var(--accent-2);
    font-weight: 600;
  }
  h1 {
    font-size: clamp(26px, 4.5vw, 38px);
    font-weight: 700;
    line-height: 1.35;
    margin-top: 6px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .block {
    margin-bottom: 40px;
  }
  h2 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 16px;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
  }
  .awards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .awards li {
    position: relative;
    padding-left: 24px;
    font-weight: 500;
  }
  .awards li::before {
    content: "★";
    position: absolute;
    left: 0;
    color: var(--award);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 16px;
    line-height: 1.85;
  }
  .text + .kv {
    margin-top: 20px;
  }
  .lead {
    font-size: 16px;
    line-height: 1.85;
  }
  .lead + * {
    margin-top: 20px;
  }

  /* ラベルと値の一覧 */
  .kv {
    display: grid;
    grid-template-columns: max-content 1fr;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .kv dt,
  .kv dd {
    padding: 11px 18px;
    border-top: 1px solid var(--border);
  }
  .kv dt:first-of-type,
  .kv dd:first-of-type {
    border-top: none;
  }
  .kv dt {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dim);
    white-space: nowrap;
    padding-top: 12px;
  }
  .kv dd {
    font-size: 15px;
    padding-left: 0;
  }

  .points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .points li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.85;
  }
  .points li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-2);
  }

  /* ゲーム開発に活かせること・こだわった設計 */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 12px;
  }
  .info-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: var(--shadow);
    padding: 18px 20px;
  }
  .info-card h3 {
    font-size: 16px;
    color: var(--accent);
    margin-bottom: 0;
  }
  .info-card p {
    font-size: 15px;
    line-height: 1.8;
  }

  /* 制作の流れ */
  .steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .step {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 20px;
  }
  .step-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-bottom: 6px;
  }
  .step-head h3 {
    font-size: 17px;
    color: var(--text);
    margin-bottom: 0;
  }
  .step-num {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--accent);
  }
  .step p {
    font-size: 15px;
    line-height: 1.85;
  }
  .badge {
    font-size: 13px;
    font-weight: 600;
    padding: 1px 9px;
    border-radius: 999px;
    white-space: nowrap;
    color: var(--tag-text);
    background: var(--tag-bg);
    border: 1px solid var(--tag-border);
  }

  /* 表 */
  .table-block + .table-block {
    margin-top: 24px;
  }
  .table-caption {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .table-wrap {
    overflow-x: auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 10px 14px;
    border-top: 1px solid var(--border);
  }
  thead th {
    border-top: none;
    font-weight: 600;
    color: var(--text-dim);
    background: var(--bg-soft);
  }
  td:first-child {
    font-weight: 600;
    white-space: nowrap;
  }
  /* 最後の列は「ディレクター」「メイン」など短い語なので折り返さない */
  th:last-child,
  td:last-child {
    white-space: nowrap;
  }

  .videos {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent-2);
    margin-bottom: 10px;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-desc {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.85;
    color: var(--text-dim);
  }

  @media (max-width: 560px) {
    .kv {
      grid-template-columns: 1fr;
    }
    .kv dt {
      padding-bottom: 0;
    }
    .kv dd {
      border-top: none;
      padding: 2px 18px 11px;
    }
  }
</style>
