---
import Base from "../../layouts/Base.astro";
import circleList from "../../data/circle.json";
import { youtubeId } from "../../utils/youtube.js";

export function getStaticPaths() {
  return circleList.map((circle) => ({
    params: { slug: circle.slug },
    props: { circle },
  }));
}

const { circle } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// description は文字列でも、段落ごとの配列でもよい
const paragraphs = [].concat(circle.description ?? []).filter(Boolean);
const videos = (circle.videos ?? [])
  .filter((v) => v.url)
  .map((v) => ({ ...v, id: youtubeId(v.url) }));
---

<Base title={circle.title} description={`${circle.circle} での活動`}>
  <main class="container">
    <a class="back" href={`${base}/#circle`}>← Club Activities に戻る</a>

    <header class="head">
      <p class="meta">
        <span class="yr">{circle.year}</span>
        <span class="circle">{circle.circle}</span>
      </p>
      <h1>{circle.title}</h1>
      <div class="tags">
        {circle.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {
      circle.awards?.length > 0 && (
        <section class="block">
          <h2>受賞歴</h2>
          <ul class="awards">
            {circle.awards.map((a) => <li>{a}</li>)}
          </ul>
        </section>
      )
    }

    {
      paragraphs.length > 0 && (
        <section class="block">
          <h2>作品について</h2>
          <div class="text">
            {paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>
      )
    }

    {
      videos.length > 0 && (
        <section class="block">
          <h2>動画</h2>
          <div class="videos">
            {videos.map((v) => (
              <div class="video">
                {v.title && <h3>{v.title}</h3>}
                {v.id ? (
                  <div class="frame">
                    <iframe
                      src={`https://www.youtube.com/embed/${v.id}`}
                      title={`${circle.title} ${v.title ?? "動画"}`}
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                      allowfullscreen
                    />
                  </div>
                ) : (
                  <a class="btn btn-ghost" href={v.url} target="_blank" rel="noopener">
                    動画を開く
                  </a>
                )}
                {v.description && <p class="video-desc">{v.description}</p>}
              </div>
            ))}
          </div>
        </section>
      )
    }
  </main>
</Base>

<style>
  main {
    padding: 48px 24px 100px;
    max-width: 820px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 40px;
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--accent);
  }
  .head {
    margin-bottom: 40px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 14px;
  }
  .yr {
    font-family: "JetBrains Mono", monospace;
    color: var(--accent);
  }
  .circle {
    color: var(--accent-2);
    font-weight: 600;
  }
  h1 {
    font-size: clamp(26px, 4.5vw, 38px);
    font-weight: 700;
    line-height: 1.35;
    margin-top: 6px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
  }
  .block {
    margin-bottom: 40px;
  }
  h2 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 16px;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
  }
  .awards {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .awards li {
    position: relative;
    padding-left: 24px;
    font-weight: 500;
  }
  .awards li::before {
    content: "★";
    position: absolute;
    left: 0;
    color: var(--award);
  }
  .text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 16px;
    line-height: 1.85;
  }
  .videos {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--accent-2);
    margin-bottom: 10px;
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-desc {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.85;
    color: var(--text-dim);
  }
</style>
