---
import { Code } from "astro:components";
import Base from "../../layouts/Base.astro";
import RichText from "../../components/RichText.astro";
import works from "../../data/works.json";

export function getStaticPaths() {
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const thumb = work.thumbnail ? base + work.thumbnail : null;
const period = work.period ? [work.period].flat() : [];
// 文字列だけの highlights（タイトルのみ）にも対応する
const highlights = (work.highlights ?? []).map((h) => (typeof h === "string" ? { title: h } : h));
const pad = (n) => String(n).padStart(2, "0");
---

<Base title={work.title} description={work.tagline}>
  <main class="container">
    <a class="back" href={`${base}/`}>← Works に戻る</a>

    <header class="head">
      <span class="yr">{work.year}</span>
      <h1>{work.title}</h1>
      <p class="tagline">{work.tagline}</p>
      <div class="tags">
        {work.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <div class="actions">
        {
          work.repo && (
            <a class="btn btn-primary" href={work.repo} target="_blank" rel="noopener">
              GitHub リポジトリ
            </a>
          )
        }
        {
          work.demo && (
            <a class="btn btn-ghost" href={work.demo} target="_blank" rel="noopener">
              ブラウザでプレイ
            </a>
          )
        }
        {
          work.doc && (
            <a class="btn btn-ghost" href={base + work.doc} target="_blank" rel="noopener">
              企画書を見る
            </a>
          )
        }
      </div>
    </header>

    {
      thumb && (
        <div class="hero-img">
          <img src={thumb} alt={work.title} />
        </div>
      )
    }

    {
      work.video && (
        <div class="video">
          <iframe
            src={work.video}
            title={`${work.title} demo video`}
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          />
        </div>
      )
    }

    <section class="section">
      <h2>概要</h2>
      <p>{work.description}</p>
      {
        (period.length > 0 || work.stack) && (
          <dl class="kv spec">
            {period.length > 0 && (
              <>
                <dt>開発期間</dt>
                <dd>
                  {period.map((p) => (
                    <span class="line">{p}</span>
                  ))}
                </dd>
              </>
            )}
            {work.stack?.map((s) => (
              <>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </>
            ))}
          </dl>
        )
      }
    </section>

    {
      work.gameplay && (
        <section class="section">
          <h2>ゲーム概要</h2>
          {work.gameplay.summary && <p class="lead">{work.gameplay.summary}</p>}
          <dl class="kv">
            {work.gameplay.items.map((item) => (
              <>
                <dt>{item.label}</dt>
                <dd>
                  <RichText text={item.text} />
                </dd>
              </>
            ))}
          </dl>
          {work.gameplay.image && (
            <figure class="figure">
              <img src={base + work.gameplay.image} alt={`${work.title} の遊び方`} loading="lazy" />
            </figure>
          )}
        </section>
      )
    }

    {
      work.algorithms && (
        <section class="section">
          <h2>アルゴリズム概要</h2>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>機能</th>
                  <th>アルゴリズム / データ構造</th>
                  <th>計算量</th>
                  <th>狙い</th>
                </tr>
              </thead>
              <tbody>
                {work.algorithms.rows.map((r) => (
                  <tr>
                    <td class="feature">{r.feature}</td>
                    <td>
                      <RichText text={r.method} />
                    </td>
                    <td class="complexity">{r.complexity}</td>
                    <td>
                      <RichText text={r.aim} />
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {work.algorithms.note && <p class="note">※ {work.algorithms.note}</p>}
        </section>
      )
    }

    {
      highlights.length > 0 && (
        <section class="section">
          <h2>技術的なこだわり</h2>
          <ol class="hl-list">
            {highlights.map((h, i) => (
              <li class="hl">
                <div class="hl-head">
                  <span class="hl-num">{pad(i + 1)}</span>
                  <h3>{h.title}</h3>
                  {h.badge && <span class="badge">{h.badge}</span>}
                </div>
                {h.summary && (
                  <p class="hl-summary">
                    <RichText text={h.summary} />
                  </p>
                )}
                {h.code?.map((c) => (
                  <figure class="code">
                    {c.label && <figcaption>{c.label}</figcaption>}
                    <Code code={c.src.join("\n")} lang={c.lang} theme="github-dark" />
                  </figure>
                ))}
                {h.points && (
                  <ul class="points">
                    {h.points.map((p) => (
                      <li>
                        <RichText text={p} />
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      work.updates && (
        <section class="section">
          <h2>{work.updates.title}</h2>
          <dl class="kv">
            {work.updates.items.map((item) => (
              <>
                <dt>{item.label}</dt>
                <dd>
                  <RichText text={item.text} />
                </dd>
              </>
            ))}
          </dl>
        </section>
      )
    }

    {
      work.features && (
        <section class="section">
          <h2>実装機能一覧</h2>
          <ul class="features">
            {work.features.map((f) => (
              <li>
                <strong>{f.label}</strong>
                <span>
                  <RichText text={f.text} />
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      work.aiUsage && (
        <section class="section">
          <h2>AI の使用について</h2>
          <p class="note-box">
            <RichText text={work.aiUsage} />
          </p>
        </section>
      )
    }

    <a class="back back-bottom" href={`${base}/`}>← Works に戻る</a>
  </main>
</Base>

<style>
  main {
    padding: 48px 24px 100px;
    max-width: 820px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 40px;
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--accent);
  }
  .back-bottom {
    margin: 8px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--border);
    width: 100%;
  }
  .yr {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(34px, 6vw, 52px);
    font-weight: 700;
    line-height: 1.1;
    margin: 6px 0 10px;
  }
  .tagline {
    font-size: 17px;
    color: var(--text-dim);
    margin-bottom: 18px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }
  .hero-img {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    margin-bottom: 40px;
  }
  .hero-img img {
    width: 100%;
    display: block;
  }
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    margin-bottom: 48px;
  }
  .video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .section {
    margin-bottom: 56px;
  }
  h2 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 16px;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
  }
  .section > p {
    color: var(--text);
    font-size: 16px;
    line-height: 1.85;
  }
  .lead {
    margin-bottom: 20px;
  }

  /* ラベルと値の一覧（スペック・ゲーム概要・変更点） */
  .kv {
    display: grid;
    grid-template-columns: max-content 1fr;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }
  .spec {
    margin-top: 24px;
  }
  .kv dt,
  .kv dd {
    padding: 11px 18px;
    border-top: 1px solid var(--border);
  }
  .kv dt:first-of-type,
  .kv dd:first-of-type {
    border-top: none;
  }
  .kv dt {
    font-size: 14px;
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
    padding-top: 13px;
  }
  .spec dt {
    font-family: "JetBrains Mono", "Noto Sans JP", monospace;
    font-weight: 500;
    color: var(--text-dim);
  }
  .kv dd {
    font-size: 15px;
    padding-left: 0;
  }
  .line {
    display: block;
  }

  .figure {
    margin-top: 20px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .figure img {
    width: 100%;
    display: block;
  }

  .table-wrap {
    overflow-x: auto;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 11px 14px;
    border-top: 1px solid var(--border);
  }
  thead th {
    border-top: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-dim);
    background: var(--bg-soft);
    white-space: nowrap;
  }
  .feature {
    font-weight: 600;
    white-space: nowrap;
  }
  .complexity {
    font-family: "JetBrains Mono", "Noto Sans JP", monospace;
    font-size: 14px;
    color: var(--accent-2);
  }
  .note {
    margin-top: 10px;
    font-size: 14px;
    color: var(--text-dim);
  }

  /* 技術的なこだわり */
  .hl-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hl {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
  }
  .hl > :last-child {
    margin-bottom: 0;
  }
  .hl-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 12px;
    margin-bottom: 12px;
  }
  .hl-num {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    color: var(--accent);
  }
  h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.45;
  }
  .badge {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-line);
    padding: 1px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .hl-summary {
    font-size: 15px;
    line-height: 1.85;
    margin-bottom: 16px;
  }
  .code {
    margin-bottom: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
  }
  .code figcaption {
    font-family: "JetBrains Mono", "Noto Sans JP", monospace;
    font-size: 13px;
    color: var(--text-dim);
    padding: 8px 14px;
    background: var(--bg-soft);
    border-bottom: 1px solid var(--border);
  }
  .code :global(pre) {
    margin: 0;
    padding: 14px 16px;
    font-family: "JetBrains Mono", "Noto Sans JP", monospace;
    font-size: 13px;
    line-height: 1.6;
    background-color: var(--code-bg) !important;
  }
  .points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .points li {
    position: relative;
    padding-left: 22px;
    font-size: 15px;
    line-height: 1.85;
  }
  .points li::before {
    content: "▹";
    position: absolute;
    left: 0;
    color: var(--accent-2);
  }

  .features {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
  }
  .features li {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .features strong {
    display: block;
    font-size: 14px;
    color: var(--accent);
    margin-bottom: 4px;
  }
  .features span {
    font-size: 14px;
    color: var(--text-dim);
  }

  .note-box {
    padding: 16px 20px;
    background: var(--card);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent-2);
    border-radius: 12px;
    font-size: 14px;
    color: var(--text-dim);
  }

  @media (max-width: 560px) {
    .kv {
      grid-template-columns: 1fr;
    }
    .kv dt {
      padding-bottom: 0;
    }
    .kv dd {
      border-top: none;
      padding: 2px 18px 11px;
    }
    .hl {
      padding: 20px 18px;
    }
  }
</style>
