---
import Base from "../../layouts/Base.astro";
import researchList from "../../data/research.json";
import { youtubeId } from "../../utils/youtube.js";

export function getStaticPaths() {
  return researchList.map((research) => ({
    params: { slug: research.slug },
    props: { research },
  }));
}

const { research } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const videoId = youtubeId(research.video);
const slides = research.slides ? base + research.slides : null;
---

<Base title={research.title} description={`${research.conference} での発表`}>
  <main class="container">
    <a class="back" href={`${base}/#research`}>← Research に戻る</a>

    <header class="head">
      <p class="meta">
        <span class="yr">{research.year}</span>
        <span class="conference">{research.conference}</span>
      </p>
      <h1>{research.title}</h1>
    </header>

    {
      videoId && (
        <section class="block">
          <h2>発表動画</h2>
          <div class="frame">
            <iframe
              src={`https://www.youtube.com/embed/${videoId}`}
              title={`${research.title} 発表動画`}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        </section>
      )
    }

    {
      slides && (
        <section class="block">
          <h2>発表スライド</h2>
          <div class="frame slides">
            <iframe src={`${slides}#view=Fit`} title={`${research.title} 発表スライド`} />
          </div>
          <a class="btn btn-ghost" href={slides} target="_blank" rel="noopener">
            スライドを開く（PDF）
          </a>
        </section>
      )
    }
  </main>
</Base>

<style>
  main {
    padding: 48px 24px 100px;
    max-width: 820px;
  }
  .back {
    display: inline-block;
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 40px;
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--accent);
  }
  .head {
    margin-bottom: 40px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 13px;
  }
  .yr {
    font-family: "JetBrains Mono", monospace;
    color: var(--accent);
  }
  .conference {
    color: var(--accent-2);
  }
  h1 {
    font-size: clamp(26px, 4.5vw, 38px);
    font-weight: 700;
    line-height: 1.35;
    margin-top: 6px;
  }
  .block {
    margin-bottom: 40px;
  }
  h2 {
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 16px;
    padding-left: 12px;
    border-left: 3px solid var(--accent);
  }
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-soft);
  }
  .frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .slides {
    margin-bottom: 16px;
  }

  /* スマホのブラウザは PDF の埋め込み表示が不安定なので、ボタンから開いてもらう */
  @media (max-width: 640px) {
    .slides {
      display: none;
    }
  }
</style>
